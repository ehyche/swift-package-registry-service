{"metadata":{"roleHeading":"Article","title":"Specification Support","modules":[{"name":"App"}],"role":"article"},"abstract":[{"type":"text","text":"See the status of each feature in the Swift Package Registry Service specification."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/App\/documentation\/App\/SpecificationSupport"},"seeAlsoSections":[{"title":"Essentials","generated":true,"anchor":"Essentials","identifiers":["doc:\/\/App\/documentation\/App\/GettingStarted","doc:\/\/App\/documentation\/App\/ConfiguringSPM","doc:\/\/App\/documentation\/App\/GithubAPI","doc:\/\/App\/documentation\/App\/Architecture"]}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Feature Table","anchor":"Feature-Table"},{"type":"paragraph","inlineContent":[{"text":"The following table references the ","type":"text"},{"identifier":"https:\/\/github.com\/swiftlang\/swift-package-manager\/blob\/main\/Documentation\/PackageRegistry\/Registry.md","type":"reference","isActive":true},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"For each ","type":"text"},{"type":"strong","inlineContent":[{"text":"server","type":"text"}]},{"text":" feature listed in the Specification, the table says if this feature is supported in this implementation.","type":"text"},{"text":" ","type":"text"},{"text":"This table will change as more features in the server are implemented.","type":"text"}]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Section","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Specification","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Support","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"3.2","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Server MAY require authentication"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"✅ No user-level authentication to this SPR Service is required. You set the "},{"type":"codeVoice","code":"GITHUB_API_TOKEN"},{"text":" environment variable to access the Github API.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"3.2"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A server SHOULD respond with a status code of 401 (Unauthorized) if a client sends a request to an endpoint that requires authentication without providing credentials.","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"✅ No user-level authentication to this SPR Service is required. You set the "},{"type":"codeVoice","code":"GITHUB_API_TOKEN"},{"type":"text","text":" environment variable to access the Github API."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"3.2"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A server MAY respond with a status code of 404 (Not Found) or 403 (Forbidden) when a client provides valid credentials but isn’t authorized to access the requested resource."}],"type":"paragraph"}],[{"inlineContent":[{"text":"✅ No user-level authentication to this SPR Service is required. You set the ","type":"text"},{"code":"GITHUB_API_TOKEN","type":"codeVoice"},{"text":" environment variable to access the Github API.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"3.2"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A server MAY use any authentication model of its choosing.","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"✅ No user-level authentication to this SPR Service is required. You set the "},{"type":"codeVoice","code":"GITHUB_API_TOKEN"},{"type":"text","text":" environment variable to access the Github API."}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"3.3","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Server MUST communicate any errors to the client using “problem details” objects."}],"type":"paragraph"}],[{"inlineContent":[{"text":"✅","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"3.4"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Server MAY limit the number of requests made by a client by responding with a status code of "},{"type":"codeVoice","code":"429 Too Many Requests"}],"type":"paragraph"}],[{"inlineContent":[{"text":"✅","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"3.5","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Server MUST set the "},{"type":"codeVoice","code":"Content-Type"},{"type":"text","text":" header field with the corresponding content type of the response."}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"✅"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"3.5"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Server MUST set the "},{"type":"codeVoice","code":"Content-Version"},{"type":"text","text":" header field with the API version number of the response."}],"type":"paragraph"}],[{"inlineContent":[{"text":"✅","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"3.5","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"If a client sends a request without an ","type":"text"},{"code":"Accept","type":"codeVoice"},{"text":" header, a server MAY either respond with a status code of 400 Bad Request or process the request using an API version that it chooses, making sure to set the ","type":"text"},{"code":"Content-Type","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Content-Version","type":"codeVoice"},{"text":" headers accordingly.","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"✅ If no ","type":"text"},{"type":"codeVoice","code":"Accept"},{"text":" header is specified, then the request is processed assuming content version 1.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"3.5"}],"type":"paragraph"}],[{"inlineContent":[{"text":"If a client sends a request with an ","type":"text"},{"code":"Accept","type":"codeVoice"},{"text":" header that specifies an unknown or invalid API version, a server SHOULD respond with a status code of ","type":"text"},{"code":"400 Bad Request","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"✅"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"3.5"}],"type":"paragraph"}],[{"inlineContent":[{"text":"If a client sends a request with an ","type":"text"},{"code":"Accept","type":"codeVoice"},{"text":" header that specifies a valid but unsupported API version, a server SHOULD respond with a status code of ","type":"text"},{"code":"415 Unsupported Media Type","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"✅"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"3.6.1"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Package scopes are limited to 39 characters."}],"type":"paragraph"}],[{"inlineContent":[{"text":"✅","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"3.6.1","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Package scopes conform to the regular expression "},{"type":"codeVoice","code":"\\A[a-zA-Z0-9](?:[a-zA-Z0-9]|-(?=[a-zA-Z0-9])){0,38}\\z"},{"type":"text","text":"."}],"type":"paragraph"}],[{"inlineContent":[{"text":"✅","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"3.6.1"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Package scopes are case-insensitive."}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"✅"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"3.6.2","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Package names are limited to 100 characters.","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"✅","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"3.6.2","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Package names conform to the regular expression "},{"type":"codeVoice","code":"\\A[a-zA-Z0-9](?:[a-zA-Z0-9]|[-_](?=[a-zA-Z0-9])){0,99}\\z"},{"type":"text","text":"."}],"type":"paragraph"}],[{"inlineContent":[{"text":"✅","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"3.6.2"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Package names are case-insensitive."}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"✅"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"4"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A server SHOULD also respond to "},{"code":"HEAD","type":"codeVoice"},{"type":"text","text":" requests for each of the specified endpoints."}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"❌"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"4","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A server MAY respond to an "},{"type":"codeVoice","code":"OPTIONS"},{"type":"text","text":" request with a "},{"type":"codeVoice","code":"Link"},{"type":"text","text":" header containing an entry for the service-doc relation type with a link to this document, and an entry for the service-desc relation type with a link to the OpenAPI specification."}],"type":"paragraph"}],[{"inlineContent":[{"text":"❌","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"4.1","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"If a package is found at the requested location, a server SHOULD respond with a status code of "},{"code":"200 OK","type":"codeVoice"},{"type":"text","text":" and the "},{"code":"Content-Type","type":"codeVoice"},{"type":"text","text":" header "},{"code":"application\/json","type":"codeVoice"},{"type":"text","text":". Otherwise, a server SHOULD respond with a status code of "},{"code":"404 Not Found","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"✅"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"4.1","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A server SHOULD respond with a JSON document containing the releases for the requested package.","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"✅"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"4.1"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A server SHOULD communicate the unavailability of a package release using a “problem details” object.","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"✅"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"4.1"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A server SHOULD respond with a link to the highest precedence published release of the package if one exists, using a ","type":"text"},{"code":"Link","type":"codeVoice"},{"text":" header field with a ","type":"text"},{"code":"latest-version","type":"codeVoice"},{"text":" relation.","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"❌","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"4.1","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A server SHOULD list releases in order of precedence, starting with the highest precedence version."}],"type":"paragraph"}],[{"inlineContent":[{"text":"❌","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"4.1","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A server MAY include a ","type":"text"},{"code":"Link","type":"codeVoice"},{"text":" entry with the canonical relation type that locates the source repository of the package.","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"❌"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"4.1"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A server MAY include one or more "},{"type":"codeVoice","code":"Link"},{"type":"text","text":" entries with the "},{"type":"codeVoice","code":"alternate"},{"type":"text","text":" relation type for other source repository locations."}],"type":"paragraph"}],[{"inlineContent":[{"text":"❌","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"4.1"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A server MAY paginate results by responding with a ","type":"text"},{"code":"Link","type":"codeVoice"},{"text":" header.","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"✅ CLIENT_SUPPORTS_PAGINATION environment variable should be set to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" to enable pagination.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"4.1"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A server MAY respond with additional "},{"code":"Link","type":"codeVoice"},{"type":"text","text":" entries, such as one with a payment relation for sponsoring a package maintainer."}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"❌"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"4.2","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"If a release is found at the requested location, a server SHOULD respond with a status code of ","type":"text"},{"code":"200 OK","type":"codeVoice"},{"text":" and the ","type":"text"},{"code":"Content-Type","type":"codeVoice"},{"text":" header ","type":"text"},{"code":"application\/json","type":"codeVoice"},{"text":". Otherwise, a server SHOULD respond with a status code of ","type":"text"},{"code":"404 Not Found","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"✅"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"4.2","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A server SHOULD respond with a ","type":"text"},{"code":"Link","type":"codeVoice"},{"text":" header containing ","type":"text"},{"code":"latest-version","type":"codeVoice"},{"text":", ","type":"text"},{"code":"successor-version","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"predecessor-version","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"❌"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"4.2"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The link with ","type":"text"},{"type":"codeVoice","code":"latest-version"},{"text":" MAY correspond to the requested release.","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"❌","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"4.2.1","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Signed packages."}],"type":"paragraph"}],[{"inlineContent":[{"text":"❌","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"4.2.1","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A resource object SHOULD have one of the following combinations of name and type values: "},{"type":"codeVoice","code":"name=source-archive"},{"type":"text","text":" and "},{"type":"codeVoice","code":"type=application\/zip"},{"type":"text","text":"."}],"type":"paragraph"}],[{"inlineContent":[{"text":"✅","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"4.2.1","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A release MUST NOT have more than a single resource object with a given combination of name and type values.","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"✅"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"4.2.2"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A server MAY allow and\/or populate additional metadata by expanding the schema. The metadata key in the “fetch information about a package release” API response will hold the user-provided as well as the server populated metadata.","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"❌"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"4.3"}],"type":"paragraph"}],[{"inlineContent":[{"text":"If a release is found at the requested location, a server SHOULD respond with a status code of ","type":"text"},{"type":"codeVoice","code":"200 OK"},{"text":" and the ","type":"text"},{"type":"codeVoice","code":"Content-Type"},{"text":" header ","type":"text"},{"type":"codeVoice","code":"text\/x-swift"},{"text":". Otherwise, a server SHOULD respond with a status code of ","type":"text"},{"type":"codeVoice","code":"404 Not Found"},{"text":".","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"✅"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"4.3"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A server SHOULD respond with a ","type":"text"},{"code":"Content-Length","type":"codeVoice"},{"text":" header set to the size of the manifest in bytes.","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"✅","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"4.3","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A server SHOULD respond with a "},{"code":"Content-Disposition","type":"codeVoice"},{"type":"text","text":" header set to attachment with a filename parameter equal to the name of the manifest file (for example, “Package.swift”)."}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"✅"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"4.3","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A server MAY omit the "},{"code":"Content-Version","type":"codeVoice"},{"type":"text","text":" header since the response content (i.e., the manifest) SHOULD NOT change across different API versions."}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"✅"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"4.3","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A server MUST include a "},{"type":"codeVoice","code":"Link"},{"type":"text","text":" header field with a value for each version-specific package manifest file in the release’s source archive."}],"type":"paragraph"}],[{"inlineContent":[{"text":"✅","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"4.3"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Each link value SHOULD have the ","type":"text"},{"type":"codeVoice","code":"alternate"},{"text":" relation type.","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"✅","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"4.3","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Each link value SHOULD have "},{"code":"filename","type":"codeVoice"},{"type":"text","text":" attribute set to the version-specific package manifest filename."}],"type":"paragraph"}],[{"inlineContent":[{"text":"✅","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"4.3"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Each link value SHOULD have a ","type":"text"},{"code":"swift-tools-version","type":"codeVoice"},{"text":" attribute set to the Swift tools version specified by the package manifest file.","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"✅"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"4.3.1"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"If the package includes a file named Package@swift-{swift-version}.swift, the server SHOULD respond with a status code of "},{"type":"codeVoice","code":"200 OK"},{"type":"text","text":" and the content of that file in the response body."}],"type":"paragraph"}],[{"inlineContent":[{"text":"✅","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"4.3.1","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Otherwise, the server SHOULD respond with a status code of ","type":"text"},{"code":"303 See Other","type":"codeVoice"},{"text":" and redirect to the unqualified Package.swift resource.","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"✅","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"4.4"}],"type":"paragraph"}],[{"inlineContent":[{"text":"If a release is found at the requested location, a server SHOULD respond with a status code of ","type":"text"},{"code":"200 OK","type":"codeVoice"},{"text":" and the ","type":"text"},{"code":"Content-Type","type":"codeVoice"},{"text":" header ","type":"text"},{"code":"application\/zip","type":"codeVoice"},{"text":". Otherwise, a server SHOULD respond with a status code of ","type":"text"},{"code":"404 Not Found","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"✅"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"4.4","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A server MUST respond with a "},{"code":"Content-Length","type":"codeVoice"},{"type":"text","text":" header set to the size of the archive in bytes."}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"✅"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"4.4"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A server MAY respond with a "},{"type":"codeVoice","code":"Digest"},{"type":"text","text":" header containing a cryptographic digest of the source archive."}],"type":"paragraph"}],[{"inlineContent":[{"text":"❌","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"4.4","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A server SHOULD respond with a "},{"type":"codeVoice","code":"Content-Disposition"},{"type":"text","text":" header set to attachment with a filename parameter equal to the name of the package followed by a hyphen (-), the version number, and file extension (for example, “LinkedList-1.1.1.zip”)."}],"type":"paragraph"}],[{"inlineContent":[{"text":"✅","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"4.4"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A server MAY omit the ","type":"text"},{"type":"codeVoice","code":"Content-Version"},{"text":" header since the response content (i.e., the source archive) SHOULD NOT change across different API versions.","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"✅","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"4.4"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"It is RECOMMENDED for clients and servers to support range requests."}],"type":"paragraph"}],[{"inlineContent":[{"text":"❌","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"4.4"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"If a release is signed, a server MUST include "},{"code":"X-Swift-Package-Signature-Format","type":"codeVoice"},{"type":"text","text":" and "},{"code":"X-Swift-Package-Signature","type":"codeVoice"},{"type":"text","text":" headers in the response."}],"type":"paragraph"}],[{"inlineContent":[{"text":"❌","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"4.4.2","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A server MAY specify mirrors or multiple download locations using ","type":"text"},{"type":"codeVoice","code":"Link"},{"text":" header fields with a ","type":"text"},{"type":"codeVoice","code":"duplicate"},{"text":" relation.","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"❌"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"4.4.2"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A server MAY respond with a status code of ","type":"text"},{"code":"303 See Other","type":"codeVoice"},{"text":" to redirect the client to download the source archive from another host.","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"❌","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"4.5"}],"type":"paragraph"}],[{"inlineContent":[{"text":"When no url parameter is specified, a server SHOULD respond with a status code of ","type":"text"},{"code":"400 Bad Request","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"✅"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"4.5"}],"type":"paragraph"}],[{"inlineContent":[{"text":"If one or more package identifiers are associated with the specified URL, a server SHOULD respond with a status code of ","type":"text"},{"type":"codeVoice","code":"200 OK"},{"text":" and the ","type":"text"},{"type":"codeVoice","code":"Content-Type"},{"text":" header ","type":"text"},{"type":"codeVoice","code":"application\/json"},{"text":". Otherwise, a server SHOULD respond with a status code of ","type":"text"},{"type":"codeVoice","code":"404 Not Found"},{"text":".","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"✅","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"4.5","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A server SHOULD respond with a JSON document containing the package identifiers for the specified URL."}],"type":"paragraph"}],[{"inlineContent":[{"text":"✅","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"4.5"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The response body MUST contain an array of package identifier strings nested at a top-level identifiers key."}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"✅"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"4.5","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A server SHOULD validate the package author’s ownership claim on the corresponding repository.","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"✅"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"4.6","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Create a Package Release","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"❌ Publishing is not supported."}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"4.6","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Support for this endpoint is OPTIONAL. A server SHOULD indicate that publishing isn’t supported by responding with a status code of 405 (Method Not Allowed)."}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"✅"}],"type":"paragraph"}]]],"header":"row"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","variants":[{"paths":["\/documentation\/app\/specificationsupport"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/App\/documentation\/App"]]},"references":{"doc://App/documentation/App/GithubAPI":{"role":"article","kind":"article","type":"topic","title":"Github API","url":"\/documentation\/app\/githubapi","abstract":[{"text":"We can implement a Swift Package Registry Service by using these four operations in the Github API:","type":"text"}],"identifier":"doc:\/\/App\/documentation\/App\/GithubAPI"},"doc://App/documentation/App/GettingStarted":{"identifier":"doc:\/\/App\/documentation\/App\/GettingStarted","type":"topic","kind":"article","url":"\/documentation\/app\/gettingstarted","title":"Getting started","abstract":[{"text":"Learn how to build and run the Swift Package Registry Service.","type":"text"}],"role":"article"},"doc://App/documentation/App/Architecture":{"role":"article","kind":"article","type":"topic","title":"Architecture","url":"\/documentation\/app\/architecture","abstract":[{"text":"This article describes the architecture of the Swift Package Registry Service.","type":"text"}],"identifier":"doc:\/\/App\/documentation\/App\/Architecture"},"doc://App/documentation/App":{"title":"App","role":"collection","url":"\/documentation\/app","kind":"symbol","identifier":"doc:\/\/App\/documentation\/App","type":"topic","abstract":[{"text":"The Swift Package Registry Service is a Vapor-based web service which implements the Swift Package Registry Service Specification by proxying and caching the Github API.","type":"text"}]},"https://github.com/swiftlang/swift-package-manager/blob/main/Documentation/PackageRegistry/Registry.md":{"type":"link","title":"Swift Package Registry Service Specification","titleInlineContent":[{"text":"Swift Package Registry Service Specification","type":"text"}],"identifier":"https:\/\/github.com\/swiftlang\/swift-package-manager\/blob\/main\/Documentation\/PackageRegistry\/Registry.md","url":"https:\/\/github.com\/swiftlang\/swift-package-manager\/blob\/main\/Documentation\/PackageRegistry\/Registry.md"},"doc://App/documentation/App/ConfiguringSPM":{"url":"\/documentation\/app\/configuringspm","type":"topic","abstract":[{"text":"Learn how to configure your Swift Package Manager to use the package registry.","type":"text"}],"identifier":"doc:\/\/App\/documentation\/App\/ConfiguringSPM","title":"Configuring Swift Package Manager","kind":"article","role":"article"}}}